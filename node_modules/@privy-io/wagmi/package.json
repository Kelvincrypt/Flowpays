{
  "name": "@privy-io/wagmi",
  "version": "4.0.18",
  "description": "Wagmi bindings for the react client",
  "keywords": [
    "privy",
    "wagmi"
  ],
  "homepage": "https://docs.privy.io",
  "bugs": {
    "url": "https://privy.io/slack"
  },
  "author": "privy.io",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/dts/index.d.mts",
        "default": "./dist/esm/index.mjs"
      }
    }
  },
  "module": "./dist/esm/index.js",
  "types": "./dist/dts/index.d.mts",
  "typings": "./dist/dts/index",
  "files": [
    "dist/**/*",
    "LICENSE",
    "README.md"
  ],
  "browserslist": [
    "defaults",
    "node >= 18",
    "not op_mini all"
  ],
  "devDependencies": {
    "@privy-io/build-config": "1.0.0",
    "oxlint": "1.57.0",
    "oxlint-tsgolint": "0.18.0",
    "@privy-io/react-auth": "3.47.0",
    "@privy-io/tsconfig": "0.0.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-replace": "^6.0.1",
    "@rollup/plugin-swc": "^0.4.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.6",
    "@swc/core": "^1.10.0",
    "@swc/plugin-styled-components": "^6.0.1",
    "@tsconfig/node16-strictest-esm": "^1.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.14",
    "@types/react": "~19.2.14",
    "@types/react-dom": "~19.2.3",
    "glob": "^10.3.12",
    "jest": "^29.7.0",
    "react": "19.2.3",
    "rollup": "4.60.1",
    "rollup-plugin-copy": "3.5.0",
    "rollup-plugin-dts": "^6.1.1",
    "typescript": "~6.0.2"
  },
  "peerDependencies": {
    "@privy-io/react-auth": "^3",
    "react": ">=18",
    "viem": "2.56.5",
    "wagmi": ">=2"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:types": "rollup --config rollup.types.mjs",
    "build:code": "rollup --config rollup.build.mjs",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist .turbo .swc *.tsbuildinfo",
    "clean:reset": "rm -rf dist .turbo .swc node_modules *.tsbuildinfo",
    "dev:code": "rollup --config rollup.dev.mjs --watch",
    "dev:types": "rollup --config rollup.types.mjs --watch",
    "format": "oxlint src --fix",
    "lint": "oxlint src",
    "test": "jest"
  }
}