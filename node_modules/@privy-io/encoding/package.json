{
  "name": "@privy-io/encoding",
  "version": "0.4.0",
  "description": "Utilities for encoding and decoding strings",
  "license": "Apache-2.0",
  "author": "privy.io",
  "private": false,
  "sideEffects": false,
  "exports": {
    ".": {
      "require": {
        "types": "./dist/dts/index.d.ts",
        "default": "./dist/cjs/index.js"
      },
      "import": {
        "types": "./dist/dts/index.d.mts",
        "default": "./dist/esm/index.mjs"
      }
    }
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/dts/index.d.ts",
  "files": [
    "dist/**/*",
    "LICENSE",
    "README.md"
  ],
  "browserslist": [
    "defaults",
    "not op_mini all"
  ],
  "dependencies": {
    "@scure/base": "^1.2.6"
  },
  "devDependencies": {
    "@privy-io/build-config": "1.0.0",
    "oxlint": "1.57.0",
    "oxlint-tsgolint": "0.18.0",
    "@privy-io/tsconfig": "0.0.0",
    "rolldown": "1.1.5",
    "rolldown-plugin-dts": "0.27.1",
    "rollup-plugin-copy": "3.5.0",
    "typescript": "7.0.2",
    "vite": "8.0.16",
    "vitest": "4.1.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rolldown --config rolldown.config.mjs",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist .turbo .swc *.tsbuildinfo",
    "clean:reset": "rm -rf dist .turbo .swc node_modules *.tsbuildinfo",
    "dev": "rolldown --config rolldown.config.mjs --watch",
    "format": "oxlint src --fix",
    "lint": "oxlint src",
    "test": "vitest run",
    "test:watch": "vitest"
  }
}