{
  "name": "@privy-io/js-sdk-core",
  "version": "0.78.0",
  "description": "Vanilla JS client for the Privy Auth API",
  "keywords": [
    "authentication",
    "authorization",
    "identity",
    "privacy",
    "privy",
    "user data",
    "web3"
  ],
  "license": "Apache-2.0",
  "author": "privy.io",
  "sideEffects": false,
  "type": "commonjs",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/dts/index.d.ts",
        "default": "./dist/cjs/index.js"
      },
      "import": {
        "types": "./dist/dts/index.d.mts",
        "default": "./dist/esm/index.mjs"
      }
    },
    "./smart-wallets": {
      "require": {
        "types": "./dist/dts/smart-wallets.d.ts",
        "default": "./dist/cjs/smart-wallets.js"
      },
      "import": {
        "types": "./dist/dts/smart-wallets.d.mts",
        "default": "./dist/esm/smart-wallets.mjs"
      }
    }
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/dts/index.d.ts",
  "files": [
    "dist/**/*",
    "LICENSE",
    "README.md"
  ],
  "browserslist": [
    "defaults",
    "not op_mini all"
  ],
  "dependencies": {
    "@privy-io/api-base": "1.11.0",
    "@privy-io/api-types": "0.23.0",
    "@privy-io/chains": "0.6.1",
    "@privy-io/encoding": "0.4.0",
    "@privy-io/ethereum": "0.2.5",
    "@privy-io/std": "0.0.2",
    "@privy-io/routes": "0.4.3",
    "@scure/base": "^1.2.6",
    "canonicalize": "^2.0.0",
    "eventemitter3": "^5.0.1",
    "fetch-retry": "^6.0.0",
    "jose": "^4.15.5",
    "js-cookie": "^3.0.5",
    "libphonenumber-js": "^1.12.10",
    "set-cookie-parser": "^2.6.0"
  },
  "devDependencies": {
    "@metamask/eth-sig-util": "^8.2.0",
    "@privy-io/assets-shared": "0.0.0",
    "@privy-io/build-config": "1.0.0",
    "@privy-io/eslint-plugin-privy-rules": "1.0.1",
    "oxlint": "1.57.0",
    "oxlint-tsgolint": "0.18.0",
    "@privy-io/tsconfig": "0.0.0",
    "@simplewebauthn/types": "9.0.1",
    "@solana/kit": "8.0.0",
    "@solana/wallet-standard-features": "^1.5.0",
    "@solana/web3.js": "^1.99.0",
    "@types/js-cookie": "^3.0.3",
    "@types/set-cookie-parser": "^2.4.7",
    "@types/text-encoding": "^0.0.37",
    "@wallet-standard/base": "^1.1.0",
    "@wallet-standard/core": "*",
    "@wallet-standard/features": "*",
    "msw": "^2.10.4",
    "rolldown": "1.1.5",
    "rolldown-plugin-dts": "0.27.1",
    "rollup-plugin-copy": "3.5.0",
    "text-encoding": "^0.7.0",
    "typescript": "~6.0.2",
    "vite": "8.0.16",
    "vitest": "4.1.2"
  },
  "peerDependencies": {
    "permissionless": "^0.2.47",
    "viem": "2.56.5"
  },
  "peerDependenciesMeta": {
    "permissionless": {
      "optional": true
    },
    "viem": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rolldown --config rolldown.config.mjs",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist .turbo .swc *.tsbuildinfo",
    "clean:reset": "rm -rf dist .turbo .swc node_modules *.tsbuildinfo",
    "dev": "rolldown --config rolldown.config.mjs --watch",
    "format": "oxlint src --fix",
    "lint": "oxlint src",
    "test": "vitest run",
    "test:watch": "vitest"
  }
}