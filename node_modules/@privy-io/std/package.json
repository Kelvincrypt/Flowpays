{
  "name": "@privy-io/std",
  "version": "0.0.2",
  "description": "Privy standard library",
  "license": "Apache-2.0",
  "author": "privy.io",
  "private": false,
  "sideEffects": false,
  "exports": {
    "./retry-fetch": {
      "require": {
        "types": "./dist/dts/retry-fetch.d.ts",
        "default": "./dist/cjs/retry-fetch.js"
      },
      "import": {
        "types": "./dist/dts/retry-fetch.d.mts",
        "default": "./dist/esm/retry-fetch.mjs"
      }
    },
    "./sleep": {
      "require": {
        "types": "./dist/dts/sleep.d.ts",
        "default": "./dist/cjs/sleep.js"
      },
      "import": {
        "types": "./dist/dts/sleep.d.mts",
        "default": "./dist/esm/sleep.mjs"
      }
    }
  },
  "files": [
    "dist/**/*",
    "LICENSE",
    "README.md"
  ],
  "browserslist": [
    "defaults",
    "not op_mini all"
  ],
  "dependencies": {},
  "devDependencies": {
    "@privy-io/build-config": "1.0.0",
    "@privy-io/tsconfig": "0.0.0",
    "typescript": "7.0.2",
    "oxfmt": "0.42.0",
    "oxlint": "1.57.0",
    "oxlint-tsgolint": "0.18.0",
    "rolldown": "1.1.5",
    "rolldown-plugin-dts": "0.27.1",
    "rollup-plugin-copy": "3.5.0",
    "vite": "8.0.16",
    "vitest": "4.1.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rolldown --config rolldown.config.mjs",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist .turbo .swc .tsbuildinfo",
    "clean:reset": "rm -rf dist .turbo .swc .tsbuildinfo node_modules",
    "dev": "rolldown --config rolldown.config.mjs --watch",
    "format": "oxlint src --fix",
    "lint": "oxlint src",
    "test": "vitest run",
    "test:watch": "vitest"
  }
}