//#region src/retry-fetch-options.d.ts
type RetryFetchOptions = {
  /**
   * HTTP statuses to retry. Replaces the default list; it is not merged.
   */
  retryableStatusCodes?: readonly number[];
  /**
   * Extra attempts after the first. Defaults to 3 (4 total attempts).
   */
  retryCount?: number;
  /**
   * Delay before the next attempt. Defaults to 500ms × 3^attempt.
   */
  retryDelayMilliseconds?: (attempt: number) => number;
  /**
   * When true, stamps `privy-retry-attempt` on every attempt. Defaults to true.
   */
  includeRetryAttemptHeader?: boolean;
};
//#endregion
//#region src/retry-fetch.d.ts
declare const RETRY_ATTEMPT_HEADER = "privy-retry-attempt";
/**
 * Wraps a `fetch` implementation with retries for transient HTTP statuses and thrown
 * network errors. Clones the Request per attempt so a consumed body cannot break retries.
 * An aborted request is not retried: every attempt would fail on the same signal.
 */
declare const retryFetch: (fetchImpl: typeof globalThis.fetch, { retryableStatusCodes, retryCount, retryDelayMilliseconds, includeRetryAttemptHeader }?: RetryFetchOptions) => typeof globalThis.fetch;
//#endregion
export { RETRY_ATTEMPT_HEADER, type RetryFetchOptions, retryFetch };